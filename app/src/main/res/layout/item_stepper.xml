<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris label fase. Tinggi 47dp HARUS sama dengan TasbihConnectorView.ROW_DP.
     Nomor/biji digambar oleh TasbihConnectorView, jadi numFase disembunyikan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="47dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/numFase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lblFase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif"
        android:shadowColor="#80000000"
        android:shadowDx="0" android:shadowDy="2" android:shadowRadius="3"
        android:text=""
        android:textColor="#8C8378"
        android:textSize="17sp" />
</LinearLayout>
