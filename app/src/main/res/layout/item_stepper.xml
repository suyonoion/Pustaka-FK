<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp">

    <!-- LINGKARAN NOMOR -->
    <TextView
        android:id="@+id/numFase"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_fase_inaktif"
        android:text="1"
        android:textColor="#8892B0"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- GARIS PENGHUBUNG -->
    <View
        android:id="@+id/relFase"
        android:layout_width="2dp"
        android:layout_height="20dp"
        android:background="#233554"
        app:layout_constraintTop_toBottomOf="@id/numFase"
        app:layout_constraintStart_toStartOf="@id/numFase"
        app:layout_constraintEnd_toEndOf="@id/numFase"/>

    <!-- LABEL TEKS -->
    <TextView
        android:id="@+id/lblFase"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Label"
        android:textColor="#8892B0"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/numFase"
        app:layout_constraintTop_toTopOf="@id/numFase"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>