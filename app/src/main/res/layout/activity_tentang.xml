<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- HEADER STATIS -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="70dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/header_pattern" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarTentang"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:navigationIconTint="#FFFFFF"
                app:title=" " />

            <!-- WADAH HEADER CENTER PRESISI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_logo_circle"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_launcher_fk" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#66000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="@string/nama_app"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nama_app_note"
                        android:textColor="#E6FFFFFF"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- AREA SCROLL KONTEN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CONTAINER UNTUK GARIS PENGHUBUNG + KARTU -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- GARIS PENGHUBUNG KANAL TENGAH -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- CARD 1: DESKRIPSI (GAYA ITEM SANAD LETNAN) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#FBF3E2"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#3A2313"
                        app:strokeWidth="1.5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- HEADER HIJAU DENGAN PROFIL DAN INFOS -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#3A2313"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/imgProfilDeskripsi"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_launcher_fk"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/ShapeAppearance.PustakaFK.Circle" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginStart="10dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/pustaka_status"
                                        android:textStyle="bold"
                                        android:textColor="#FFFFFF"
                                        android:textSize="11sp"
                                        android:letterSpacing="0.05" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical"
                                        android:layout_marginTop="1dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Pustaka FK"
                                            android:textSize="8.5sp"
                                            android:textColor="#D9CDB8" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" • "
                                            android:textSize="8.5sp"
                                            android:textColor="#CCA97F" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Profil Aplikasi"
                                            android:textColor="#CCA97F"
                                            android:textStyle="bold|italic"
                                            android:textSize="8.5sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="#INFO"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_emas" />
                            </LinearLayout>

                            <!-- KONTEN UTAMA KARTU -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <!-- ISI STATUS DESKRIPSI -->
                                <TextView
                                    android:id="@+id/txtIsiDeskripsiApp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/desc_app"
                                    android:textSize="12sp"
                                    android:textColor="#593F2D"
                                    android:lineSpacingExtra="3dp"
                                    android:autoLink="web"
                                    android:linksClickable="true"
                                    android:textColorLink="#3A2313" />

                                <View 
                                    android:layout_width="match_parent" 
                                    android:layout_height="1dp" 
                                    android:background="#D8C7AB"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="8dp"/>

                                <!-- FOOTER STATUS (SANFK, SAUNG, ZF) -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">
                                        <ImageView 
                                            android:layout_width="12dp" 
                                            android:layout_height="12dp" 
                                            android:src="@android:drawable/ic_menu_mylocation" 
                                            app:tint="#D2BDA3"/>
                                        <TextView 
                                            android:layout_width="wrap_content" 
                                            android:layout_height="wrap_content" 
                                            android:text="SanFK" 
                                            android:textColor="#C0A27E" 
                                            android:textSize="9sp" 
                                            android:layout_marginStart="3dp"/>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center">
                                        <ImageView 
                                            android:layout_width="12dp" 
                                            android:layout_height="12dp" 
                                            app:srcCompat="@drawable/logo_saung" 
                                            app:tint="#D2BDA3"/>
                                        <TextView 
                                            android:layout_width="wrap_content" 
                                            android:layout_height="wrap_content" 
                                            android:text="Saung" 
                                            android:textColor="#C0A27E" 
                                            android:textSize="9sp" 
                                            android:layout_marginStart="3dp"/>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center">
                                        <ImageView 
                                            android:layout_width="12dp" 
                                            android:layout_height="12dp" 
                                            app:srcCompat="@drawable/ic_launcher_zf" 
                                            app:tint="#D2BDA3"/>
                                        <TextView 
                                            android:layout_width="wrap_content" 
                                            android:layout_height="wrap_content" 
                                            android:text="ZF" 
                                            android:textColor="#C0A27E" 
                                            android:textSize="9sp" 
                                            android:layout_marginStart="3dp"/>
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 2: SANAD -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/primary"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:gravity="center_vertical"
                                android:padding="10dp"
                                android:text="@string/jalur_sanad_transmisi"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_isi_card_putih"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="10dp"
                                    android:text="@string/guru_dan_sanad"
                                    android:textColor="@color/text_primary"
                                    android:textSize="11sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <com.google.android.material.imageview.ShapeableImageView
                                        android:id="@+id/imgFotoAbah"
                                        android:layout_width="56dp"
                                        android:layout_height="56dp"
                                        android:layout_marginEnd="14dp"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/profil_abah"
                                        app:shapeAppearanceOverlay="@style/ShapeAppearance.PustakaFK.Circle"
                                        app:strokeColor="@color/accent_teal"
                                        app:strokeWidth="2dp" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="serif"
                                            android:text="@string/nama_guru"
                                            android:textColor="@color/text_primary"
                                            android:textSize="15sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="monospace"
                                            android:text="@string/nama_halaman"
                                            android:textColor="@color/accent_teal"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- CARD 3: GRID LINK TAUTAN -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/primary"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:padding="10dp"
                                android:text="@string/judul_tautan_resmi"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_isi_card_putih"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <androidx.gridlayout.widget.GridLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:columnCount="2"
                                    app:useDefaultMargins="true">

                                    <include
                                        android:id="@+id/linkSanFK"
                                        layout="@layout/item_link_tentang"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        app:layout_columnWeight="1"
                                        app:layout_gravity="fill" />

                                    <include
                                        android:id="@+id/linkSaung"
                                        layout="@layout/item_link_tentang"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        app:layout_columnWeight="1"
                                        app:layout_gravity="fill" />

                                    <include
                                        android:id="@+id/linkFB"
                                        layout="@layout/item_link_tentang"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        app:layout_columnWeight="1"
                                        app:layout_gravity="fill" />

                                    <include
                                        android:id="@+id/linkZF"
                                        layout="@layout/item_link_tentang"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        app:layout_columnWeight="1"
                                        app:layout_gravity="fill" />
                                </androidx.gridlayout.widget.GridLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- CARD 4: VERSI APLIKASI -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/primary"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:padding="10dp"
                                android:text="@string/judul_versi_app"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_isi_card_putih"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/versi_app"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </FrameLayout>

            <!-- FOOTER QUOTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/quote"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="italic" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
