<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F5"
    android:orientation="vertical">

    <!-- TOOLBAR HEADER, gaya sama dgn activity_galeri.xml supaya konsisten
         dgn layar "arsip tambahan" lain (Biografi/Sosmed/Galeri). -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C1D11">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarHalamanTersimpan"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="#D4AF37"
            app:title="STATUS TERSIMPAN"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            app:titleTextColor="#D4AF37" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHalamanTersimpan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Tampil kalau belum ada status yg ditandai sama sekali. -->
    <TextView
        android:id="@+id/txtHalamanTersimpanKosong"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="Belum ada status yang disimpan.\nTekan ikon bintang saat membaca status utk menyimpannya di sini."
        android:textColor="#8A8A8A"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
