<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/primary"
    app:strokeColor="@color/primary"
    app:strokeWidth="2dp"
    app:cardCornerRadius="16dp">

    <LinearLayout 
        android:layout_width="match_parent" 
        android:layout_height="wrap_content" 
        android:orientation="vertical" 
        android:background="@drawable/bg_isi_card_putih"
        android:padding="16dp">
        
        <!-- HEADER: FOTO + NAMA -->
        <LinearLayout 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:orientation="horizontal" 
            android:gravity="center_vertical">
            
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfilStatus"
                android:src="@drawable/profil_abah"
                android:layout_width="40dp" 
                android:layout_height="40dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PustakaFK.Circle"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content" 
                android:layout_weight="1"
                android:orientation="vertical" 
                android:layout_marginStart="12dp">
                
                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Syaikh Muhammad Zuhri" 
                    android:textStyle="bold" 
                    android:textColor="@color/text_primary"/>
                    
                <TextView 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Arsip Pribadi" 
                    android:textSize="11sp" 
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ISI STATUS -->
        <TextView
            android:id="@+id/tvStatusJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/bio_judul9_kaitan_nama_dengan_dj"
            android:textSize="12sp"
            android:layout_marginBottom="5dp"/>
            android:textColor="@color/text_on_light"
            android:lineSpacingMultiplier="1.5" />
        <View 
        android:id="@+id/garisTanya"
        android:layout_width="match_parent" 
        android:layout_height="1dp" 
        android:background="#E0E0E0"       
        android:layout_marginBottom="10dp"/>
        
        <TextView
            android:id="@+id/tvStatusIsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Isi Status"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.5" 
            android:justificationMode="inter_word"/>

        <!-- HASHTAG -->
        <TextView 
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" 
            android:text="#FatwaKehidupan  #DzikirJahar" 
            android:textColor="@color/accent_teal" 
            android:textSize="10sp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>