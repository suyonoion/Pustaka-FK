<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#FAF8F5"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp"
    app:strokeColor="#2C1D11"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- HEADER ITEM GRID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txtNomorFoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="#2C1D11"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#D4AF37"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- BINGKAI FOTO (OTOMATIS SESUAI RASIO FOTO, TIDAK TERPOTONG) -->
        <ImageView
            android:id="@+id/imgFotoAbah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- LABEL SUB -->
        <TextView
            android:id="@+id/txtSubKategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#8C6D46"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
