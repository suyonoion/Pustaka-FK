<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- KOMPARTEMEN 1: PENAMPANG UTAMA + TIMELINE MELAYANG -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1A. ISI KONTEN LAMA: TOOLBAR, GRID, FOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_halaman">
            <!-- TOOLBAR KAMU -->
            <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:layout_marginTop="10dp"
    android:layout_marginStart="8dp">

    <!-- TOMBOL HAMBURGER -->
    <ImageView
        android:id="@+id/btnMenuDrawer"
        android:layout_width="42dp"
        android:layout_height="34dp"
        android:padding="2dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_hamburger_menu"
        app:tint="#004D40" />

    <!-- KOTAK PENCARIAN -->
       <!-- KOTAK PENCARIAN -->
    <androidx.appcompat.widget.SearchView
    android:id="@+id/edtPencarian"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_weight="1"
    android:layout_marginStart="2dp"
    android:layout_marginHorizontal="2dp"
    android:paddingVertical="2dp"
    android:paddingHorizontal="2dp"
    android:background="#FFFFFF"
    app:iconifiedByDefault="false"
    app:queryHint="Cari status..."
    android:elevation="2dp"
    android:gravity="center_vertical"
    app:searchIcon="@android:drawable/ic_menu_search"
    app:queryBackground="@android:color/transparent" />
<!-- TOMBOL OPERASIONAL: Filter / Sort Modal -->
    <ImageButton
        android:id="@+id/btnFilterSort"
        android:layout_width="45dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_filter"
        android:contentDescription="Filter dan Urutkan Status" />
</LinearLayout>

            <!-- CARD STATUS -->
            <androidx.cardview.widget.CardView
            android:id="@+id/panelStatusPencarian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="0dp"
            android:padding="0dp"
            android:layout_margin="0dp"
            app:cardBackgroundColor="@color/timeline_pil_stroke"
            app:cardElevation="2dp"
            android:visibility="visible">

            <!-- Diubah menjadi HORIZONTAL agar indikator bersisian dengan teks -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="4dp">

                <!-- Lampu Sinyal Pemuatan (Telah diberi dimensi presisi) -->
               <ProgressBar 
                   android:id="@+id/loadingPencarian" 
                   android:layout_width="14dp" 
                   android:layout_height="14dp" 
                   android:layout_marginEnd="6dp"
                   android:indeterminateTint="#FFFFFF"
                   android:visibility="gone"/>

                <!-- Teks Dominan Rata Tengah -->
                <TextView
                    android:id="@+id/txtStatusPencarian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:text="PUSTAKA FATWA KEHIDUPAN" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

            <!-- WADAH MULTI-JALUR: HAPUS KONTANER KANAN LAMA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- JALUR KIRI: GRID SAJA. LEBAR FULL -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerGridMode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="45dp"
                        android:paddingVertical="4dp"
                        android:clipToPadding="false" />
                        <!-- GARIS VERTIKAL BARU -->
                   <RelativeLayout
            android:id="@+id/wadahModeBuku"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <com.fk.arsip.curl.BudayakanBaca
                android:id="@+id/curlViewBuku"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </RelativeLayout>

        <!-- SKELETON/PLACEHOLDER GRID: tampil saat data grid & timeline belum siap dibind, agar area ini tidak terlihat "mati"/blank kosong. Disembunyikan otomatis di pompaDataKeLayar(). -->
        <LinearLayout
            android:id="@+id/wadahLoadingGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="45dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/bg_halaman"
            android:visibility="visible">

            <ProgressBar
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:indeterminateTint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memuat status..."
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />
        </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- BAR AKSI BACA (CurlView OpenGL tidak bisa punya tombol interaktif DI DALAM tekstur-nya. lihat penjelasan di percakapan. Bar ini persisten di luar permukaan OpenGL,kontennya diperbarui MainActivity setiap halaman berganti lewat BudayakanBaca.PenggantiHalamanListener). Disembunyikan kecuali sedang di mode baca. -->
            <LinearLayout
                android:id="@+id/barAksiBaca"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/bg_halaman"
                android:elevation="6dp"
                android:baselineAligned="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnAksiSumberAsli"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_share"
                        app:tint="@color/primary"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sumber Asli"
                        android:textColor="@color/primary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#DDDDDD"/>

                <LinearLayout
                    android:id="@+id/btnAksiBagikan"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_share"
                        app:tint="@color/primary"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bagikan"
                        android:textColor="@color/primary"
                        android:textSize="12sp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#DDDDDD"/>

                <LinearLayout
                    android:id="@+id/btnAksiLampiran"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:tint="@color/primary"
                        android:layout_marginEnd="6dp"/>
                    <TextView
                        android:id="@+id/txtLabelLampiran"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lampiran"
                        android:textColor="@color/primary"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- FOOTER KAMU -->
                            <LinearLayout
            android:id="@+id/footerBawahUtama"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/timeline_pil_stroke"
            android:elevation="6dp"
            android:baselineAligned="false">
            
            <LinearLayout
                android:id="@+id/linkSanFK_induk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SanFK"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linkSaung_induk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/logo_saung"
                    app:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saung"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linkZF_induk"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:srcCompat="@drawable/ic_launcher_zf"
                    app:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZF"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- INJEKSI TERMINAL BARU: ABOUT -->
            <LinearLayout
                android:id="@+id/menuAbout"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>    
        </LinearLayout>
                          

        <!-- 1B. TIMELINE MELAYANG DI ATAS KANAN -->
    <FrameLayout
    android:id="@+id/kontainerJalurKanan"
    android:layout_width="60dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:clipChildren="false"
    android:layout_marginEnd="0dp"
    android:layout_marginRight="0dp"
    android:layout_marginTop="95dp" 
    android:layout_marginBottom="35dp" 
    android:paddingTop="2dp"
    android:paddingEnd="0dp"
    android:background="@android:color/transparent">
            
            <!-- PILAR SEKAT: GARIS TIMELINE -->
          <View 
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#B2DFDB"
                        android:layout_marginStart="19dp"
                        android:layout_marginTop="20dp"
                        />

            <!-- RECYCLERVIEW TIMELINE -->
           <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recyclerTimeline"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:layout_marginEnd="2dp"
    android:layout_marginStart="20dp"
    android:clipChildren="false" />

            <!-- SKELETON TIMELINE: titik loading kecil selagi recyclerTimeline masih kosong (belum ada adapter/data), agar kolom timeline tidak terlihat mati/blank. Disembunyikan di pompaDataKeLayar(). -->
            <ProgressBar
                android:id="@+id/loadingTimelineKecil"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/primary"
                android:visibility="visible" />
        </FrameLayout>
        <!-- Layar Kaca Pengaman (Letakkan di atas pelat utama) -->
        <include layout="@layout/layout_inisialisasi_mesin" android:layout_gravity="center"/>
    
    </FrameLayout>

    <!-- KOMPARTEMEN 2: LACI NAVIGASI -->
    <LinearLayout
        android:id="@+id/navViewCustom"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FAFAFA"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <!-- 1. GAMBAR VECTOR BACKGROUND (bg_header_drawer.xml) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_header_drawer" />

            <!-- 2. OVERLAY HITAM TRANSPARAN (Agar teks & foto kontras) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000" /> 

            <!-- 3. KONTEN FOTO PROFIL DAN TEKS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
    android:id="@+id/fotoProfilAbah"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:scaleType="centerCrop"
    android:src="@drawable/profil_abah" 
    app:shapeAppearanceOverlay="@style/ShapeAppearance.PustakaFK.Circle"
    app:strokeWidth="1.5dp"
    app:strokeColor="#80CBC4" 
    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fatwa Kehidupan"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arsip Status Digital"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"/>
            </LinearLayout>

        </FrameLayout>

        <!-- 1C. PANEL IKON MODE BACA — menempati slot yg sama persis dgn
        kontainerJalurKanan (rel timeline), tapi HANYA tampil saat mode buku
        aktif (lihat bukaModeBuku()/panelIkonBaca di MainActivity.kt). Berisi
        akses cepat drawer/cari/filter (fungsi yg sudah ada, cuma dipindah
        ke sini biar gampang dijangkau ibu jari saat baca), + beberapa
        tombol PLACEHOLDER utk fitur yg belum dibangun (lihat komentar tiap
        tombol) — ikon di bawah masih sementara, ganti kalau sudah ada aset final. -->
        <LinearLayout
            android:id="@+id/panelIkonBaca"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_panel_ikon_baca"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnBacaDrawer"
                style="@style/TombolIkonPanelBaca"
                android:src="@drawable/ic_hamburger_menu"
                android:contentDescription="Buka menu" />

            <ImageButton
                android:id="@+id/btnBacaCari"
                style="@style/TombolIkonPanelBaca"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Cari status" />

            <ImageButton
                android:id="@+id/btnBacaFilter"
                style="@style/TombolIkonPanelBaca"
                android:src="@drawable/ic_filter"
                android:contentDescription="Filter dan urutkan" />

            <View style="@style/PemisahPanelIkonBaca" />

            <!-- PLACEHOLDER — belum diimplementasi, lihat MainActivity.kt (pasangPanelIkonBaca) -->
            <ImageButton
                android:id="@+id/btnBacaEksporPdf"
                style="@style/TombolIkonPanelBaca"
                android:src="@android:drawable/ic_menu_save"
                android:contentDescription="Ekspor ke PDF" />

            <ImageButton
                android:id="@+id/btnBacaTandai"
                style="@style/TombolIkonPanelBaca"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="Simpan / tandai halaman" />

            <ImageButton
                android:id="@+id/btnBacaHalamanTersimpan"
                style="@style/TombolIkonPanelBaca"
                android:src="@android:drawable/ic_menu_agenda"
                android:contentDescription="Halaman tersimpan" />

            <ImageButton
                android:id="@+id/btnBacaUkuranTeks"
                style="@style/TombolIkonPanelBaca"
                android:src="@android:drawable/ic_menu_zoom"
                android:contentDescription="Atur ukuran teks" />

            <ImageButton
                android:id="@+id/btnBacaModeGelap"
                style="@style/TombolIkonPanelBaca"
                android:src="@android:drawable/ic_menu_compass"
                android:contentDescription="Mode gelap / terang" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">
                
                <!-- Menu Statis Atas -->
                <TextView 
                    android:id="@+id/menuBiografi" 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="Biografi" 
                    android:drawableStart="@android:drawable/ic_menu_info_details" 
                    android:drawablePadding="12dp" 
                    android:textColor="#212121" 
                    android:textSize="13sp" 
                    android:paddingVertical="8dp" 
                    android:paddingHorizontal="16dp" 
                    app:tint="#004D40"
                    android:background="?android:attr/selectableItemBackground"/>

                <TextView 
                    android:id="@+id/menuSosmed" 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="Sosial Media" 
                    android:drawableStart="@android:drawable/ic_menu_share" 
                    android:drawablePadding="12dp" 
                    android:textColor="#212121" 
                    android:textSize="13sp" 
                    android:paddingVertical="8dp" 
                    android:paddingHorizontal="16dp" 
                    app:tint="#004D40"
                    android:background="?android:attr/selectableItemBackground"/>

                <TextView 
                    android:id="@+id/menuLetnan" 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="Letnan" 
                    android:drawableStart="@android:drawable/ic_menu_myplaces" 
                    android:drawablePadding="12dp" 
                    android:textColor="#212121" 
                    android:textSize="13sp" 
                    android:paddingVertical="8dp" 
                    android:paddingHorizontal="16dp" 
                    app:tint="#004D40"
                    android:background="?android:attr/selectableItemBackground"/>
                
                <TextView 
                    android:id="@+id/menuGammaLocking" 
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" 
                    android:text="Gamma Locking" 
                    android:drawableStart="@drawable/ic_gamma_locking" 
                    android:drawablePadding="12dp" 
                    android:textColor="#212121" 
                    android:textSize="13sp" 
                    android:paddingVertical="8dp" 
                    android:paddingHorizontal="16dp" 
                    android:background="?android:attr/selectableItemBackground"
                    app:tint="#004D40" />
  <!-- MENU GALERI FOTO (TAMBAHAN BARU) -->
                <TextView 
                    android:id="@+id/menuGaleriFoto" 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="Galeri Foto" 
                    android:drawableStart="@android:drawable/ic_menu_gallery" 
                    android:drawablePadding="12dp" 
                    android:textColor="#212121" 
                    android:textSize="13sp" 
                    android:paddingVertical="8dp" 
                    android:paddingHorizontal="16dp" 
                    app:tint="#004D40"
                    android:background="?android:attr/selectableItemBackground"/>
                <View 
                    android:layout_width="match_parent" 
                    android:layout_height="1dp" 
                    android:background="#E0E0E0" 
                    android:layout_marginVertical="4dp"/>
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KATEGORI STATUS"
                    android:textStyle="bold"
                    android:textColor="#004D40"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:id="@+id/wadahKategoriDinamis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"/>
            </LinearLayout>

        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>