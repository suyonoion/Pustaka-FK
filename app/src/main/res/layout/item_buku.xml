<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- HEADER HALAMAN (didesain ulang, portrait & landscape sama rapi):
         baris 1 = foto profil BULAT berbingkai emas + nama + sumber, badge halaman (pil) di kanan;
         baris 2 = tanggal • kategori selebar penuh (tidak lagi berdesakan dgn badge).
         wadahProfilPenulis (avatar+nama+tanggal+kategori) disembunyikan di halaman lanjutan
         (subIndex>0, lihat BookPageProvider); txtNomorHalaman selalu tampil. -->
    <LinearLayout
        android:id="@+id/wadahHeaderHalaman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/wadahProfilPenulis"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgProfilAbah"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="2.5dp"
                    android:background="@drawable/bg_avatar_cincin"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Syeikh Muhammad Zuhri"
                        android:textColor="#3A2313"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtNamaSumberBuku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Fatwa Kehidupan"
                        android:textColor="#B8802E"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/txtTanggalKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tanggal • Kategori"
                android:textSize="11sp"
                android:lineSpacingExtra="1dp"
                android:textColor="#5A4A3C" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNomorHalaman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_halaman"
            android:text="Halaman : -/-"
            android:textColor="#9A6A1E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D8C7AB" android:layout_marginBottom="12dp"/>

    <ScrollView
        android:id="@+id/scrollKontenBuku"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/wadahKontenBerbaris"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <!-- TEKS ASLI PEMOSTING UTAMA ("Mantap... DJ nya...") -->
            <TextView
                android:id="@+id/txtKontenUtama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#212121"
                android:autoLink="web"
                android:linksClickable="true"
                android:textColorLink="#DF9320"
                android:layout_marginBottom="10dp"/>

            <!-- WADAH DINAMIS (Merangkum Teks Shared + Foto/Video) -->
            <LinearLayout
                android:id="@+id/wadahDinamisKonten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                
                <!-- HEADER SHARED POST (Logo & Nama) -->
                <LinearLayout
                    android:id="@+id/wadahHeaderShared"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">
                                        <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#9E9E9E"
                        android:scaleType="centerInside"
                        android:background="#EAEAEA"
                        android:padding="6dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:id="@+id/txtNamaPemilikShared"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#231E1A"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status Dibagikan"
                            android:textColor="#776859"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- TEKS SHARED POST ("Assalamu'alaikum...") -->
                <TextView
                    android:id="@+id/txtKontenShared"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#231E1A"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:textColorLink="#DF9320"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"/>

                <!-- PROYEKTOR MEDIA (Selalu berada di bagian paling bawah teks) -->
                <LinearLayout
                    android:id="@+id/wadahMultiFoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wadahFooterDekoratif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:id="@+id/linkSumberTautan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" app:srcCompat="@drawable/logo_fb"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sumber Asli" android:textColor="#B47C36" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
                </LinearLayout>
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
                <LinearLayout
                    android:id="@+id/btnBagikanKonten"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_share" app:tint="#424242"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bagikan" android:textColor="#424242" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
                </LinearLayout>
                    
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
