<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panelInisialisasiUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004D40"
    android:padding="16dp">

    <!-- JUDUL -->
    <TextView
        android:id="@+id/teksJudulAplikasi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PUSTAKA FK"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- GAMBAR -->
    <ImageView
        android:id="@+id/indikatorVisualMesin"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/img_1"
        app:layout_constraintTop_toBottomOf="@id/teksJudulAplikasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" /> 

    <!-- PROGRESS LINGKARAN -->
  <ProgressBar
    android:id="@+id/progressBarInisialisasi"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="0dp"
    android:layout_height="8dp"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/progress_bar_toska"
    app:layout_constraintTop_toBottomOf="@id/indikatorVisualMesin"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginHorizontal="40dp"/>

    <!-- TEKS % DI TENGAH PROGRESS -->
    <TextView
        android:id="@+id/teksDetailProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0%"
        android:textColor="#E0F2F1"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/progressBarInisialisasi"
        app:layout_constraintBottom_toBottomOf="@id/progressBarInisialisasi"
        app:layout_constraintStart_toStartOf="@id/progressBarInisialisasi"
        app:layout_constraintEnd_toEndOf="@id/progressBarInisialisasi"/>

    <!-- TEKS STATUS PINDAH KE SINI -->
    <TextView
        android:id="@+id/teksStatusInisialisasi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textColor="#80CBC4" 
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/progressBarInisialisasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <!-- TEKS NASEHAT DINAMIS -->
    <TextView
        android:id="@+id/teksNasehatInisialisasi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#B2DFDB"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="Mencari ilmu adalah proses menata pemahaman..."
        app:layout_constraintWidth_percent="0.85"
        app:layout_constraintTop_toBottomOf="@id/teksStatusInisialisasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- PEMBATAS -->
    <View
        android:id="@+id/pembatasSektor"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#00695C"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/teksNasehatInisialisasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SEKTOR REL STEPPER FASE -->
    <ScrollView
        android:id="@+id/panelStepperUtama"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/pembatasSektor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/wadahStepperFase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <!-- ITEM FASE TEMPLATE -->
            <include layout="@layout/item_fase" android:id="@+id/itemFase1"/>
            <View android:id="@+id/relFase1" style="@style/RelStepper"/>
            
            <include layout="@layout/item_fase" android:id="@+id/itemFase2"/>
            <View android:id="@+id/relFase2" style="@style/RelStepper"/>
            
            <include layout="@layout/item_fase" android:id="@+id/itemFase3"/>
            <View android:id="@+id/relFase3" style="@style/RelStepper"/>
            
            <include layout="@layout/item_fase" android:id="@+id/itemFase4"/>
            <View android:id="@+id/relFase4" style="@style/RelStepper"/>
            
            <include layout="@layout/item_fase" android:id="@+id/itemFase5"/>
            <View android:id="@+id/relFase5" style="@style/RelStepper"/>
            
            <include layout="@layout/item_fase" android:id="@+id/itemFase6"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>