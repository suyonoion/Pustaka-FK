<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panelInisialisasiUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F"
    android:elevation="10dp">

    <!-- HEADER TITLE -->
    <TextView
        android:id="@+id/teksJudulUtama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arsip Status Fatwa Kehidupan"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- SEKTOR REAKTOR VISUAL UTAMA (SISI ATAS) -->
    <ImageView
        android:id="@+id/indikatorVisualMesin"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/img_1"
        app:layout_constraintTop_toBottomOf="@id/teksJudulUtama"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/teksStatusInisialisasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#64FFDA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="Menghubungkan ke Server..."
        app:layout_constraintTop_toBottomOf="@id/indikatorVisualMesin"
        android:layout_marginTop="8dp"/>

    <!-- PROGRESS BAR & TELEMETRI (KOREKSI PERSENTASE LEBAR) -->
    <ProgressBar
        android:id="@+id/progressBarInisialisasi"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        app:layout_constraintWidth_percent="0.8"
        app:layout_constraintTop_toBottomOf="@id/teksStatusInisialisasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/teksDetailProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8892B0"
        android:textSize="12sp"
        android:gravity="center"
        tools:text="Progres: 0% • 0 KB/s"
        app:layout_constraintTop_toBottomOf="@id/progressBarInisialisasi"
        android:layout_marginTop="4dp"/>

    <!-- TEKS NASEHAT DINAMIS (KOREKSI PERSENTASE LEBAR) -->
    <TextView
        android:id="@+id/teksNasehatInisialisasi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#CCD6F6"
        android:textSize="11sp"
        android:textStyle="italic"
        tools:text="Mencari ilmu adalah proses menata pemahaman..."
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toBottomOf="@id/teksDetailProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"/>

    <View
        android:id="@+id/pembatasSektor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#233554"
        app:layout_constraintTop_toBottomOf="@id/teksNasehatInisialisasi"
        android:layout_marginTop="8dp"/>

    <!-- SEKTOR REL STEPPER FASE 1-7 (BAGIAN BAWAH) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/pembatasSektor"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/wadahStepperFase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- FASE 1 -->
            <LinearLayout android:id="@+id/itemFase1" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase1" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="1" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Memulai aplikasi pertama kali..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>
            <View android:id="@+id/relFase1" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="13dp" android:background="#233554" />

            <!-- FASE 2 -->
            <LinearLayout android:id="@+id/itemFase2" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase2" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="2" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Menghubungkan ke server..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>
            <View android:id="@+id/relFase2" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="13dp" android:background="#233554" />

            <!-- FASE 3 -->
            <LinearLayout android:id="@+id/itemFase3" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase3" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="3" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Mengunduh data status..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>
            <View android:id="@+id/relFase3" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="13dp" android:background="#233554" />

            <!-- FASE 4 -->
            <LinearLayout android:id="@+id/itemFase4" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase4" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="4" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Menunggu jaringan jelek..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>
            <View android:id="@+id/relFase4" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="13dp" android:background="#233554" />

            <!-- FASE 5 -->
            <LinearLayout android:id="@+id/itemFase5" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase5" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="5" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Mengelas blok data ke memori..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>
            <View android:id="@+id/relFase5" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="13dp" android:background="#233554" />

            <!-- FASE 6 -->
            <LinearLayout android:id="@+id/itemFase6" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase6" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="6" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Injeksi baris data ke SQLite..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>
            <View android:id="@+id/relFase6" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="13dp" android:background="#233554" />

            <!-- FASE 7 -->
            <LinearLayout android:id="@+id/itemFase7" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/numFase7" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_fase_inaktif" android:gravity="center" android:text="7" android:textColor="#8892B0" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/lblFase7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Proses selesai..." android:textColor="#8892B0" android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
