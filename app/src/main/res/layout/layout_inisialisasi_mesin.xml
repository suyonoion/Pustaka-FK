<?xml version="1.0" encoding="utf-8"?>
<!-- Layar inisialisasi mesin, desain "Gambar B" (kayu + tasbih).
     Responsif: semua posisi horizontal memakai constraint/guideline persen,
     lebar bar/ornamen mengikuti layar, dan ScrollView + fillViewport menjaga
     tampilan tetap utuh di layar pendek / landscape. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelStepperUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kayu_mandala"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:visibility="gone">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelInisialisasiUtama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="640dp"
        android:visibility="gone">

        <!-- Bingkai ukiran & ornamen sudut (digambar vektor, ikut ukuran layar) -->
        <com.fk.arsip.FrameMandalaView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/teksJudulAplikasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="PUSTAKA FK"
            android:textColor="#F0CF94"
            android:textSize="30sp"
            android:textStyle="bold|italic"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:shadowColor="#99000000"
            android:shadowDx="0" android:shadowDy="3" android:shadowRadius="6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Visual bergerak per fase: kitab emas + tasbih berputar (VisualFaseView) -->
        <com.fk.arsip.VisualFaseView
            android:id="@+id/indikatorVisualMesin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintWidth_max="280dp"
            app:layout_constraintWidth_percent="0.70"
            app:layout_constraintTop_toBottomOf="@id/teksJudulAplikasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Kapsul persentase -->
        <TextView
            android:id="@+id/teksDetailProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_persentase_outline"
            android:fontFamily="serif"
            android:minWidth="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="0%"
            android:textColor="#F0CF94"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/progressBarInisialisasi"
            app:layout_constraintBottom_toBottomOf="@id/progressBarInisialisasi"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Progress: untaian biji tasbih -->
        <com.fk.arsip.BeadProgressView
            android:id="@+id/progressBarInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="6dp"
            app:layout_goneMarginEnd="26dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/indikatorVisualMesin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/teksDetailProgress" />

        <TextView
            android:id="@+id/teksStatusInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:gravity="center"
            android:text="Memulai…"
            android:textColor="#EBD3A0"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/progressBarInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nasehat + ornamen kiri/kanan -->
        <ImageView
            android:id="@+id/ornamenNasehatKiri"
            android:layout_width="24dp"
            android:layout_height="18dp"
            android:layout_marginStart="26dp"
            android:src="@drawable/ic_ornamen_kiri"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="@id/teksNasehatInisialisasi"
            app:layout_constraintBottom_toBottomOf="@id/teksNasehatInisialisasi"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/ornamenNasehatKanan"
            android:layout_width="24dp"
            android:layout_height="18dp"
            android:layout_marginEnd="26dp"
            android:src="@drawable/ic_ornamen_kanan"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="@id/teksNasehatInisialisasi"
            app:layout_constraintBottom_toBottomOf="@id/teksNasehatInisialisasi"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/teksNasehatInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:text="Kesabaran dalam menunggu adalah bagian dari adab menuntut ilmu."
            android:textColor="#E6D2A8"
            android:textSize="13sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            app:layout_constraintTop_toBottomOf="@id/teksStatusInisialisasi"
            app:layout_constraintStart_toEndOf="@id/ornamenNasehatKiri"
            app:layout_constraintEnd_toStartOf="@id/ornamenNasehatKanan" />

        <!-- Pembatas ornamen basmalah -->
        <com.fk.arsip.OrnamenBismillahView
            android:id="@+id/pembatasSektor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/teksNasehatInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stepper tasbih: connector menggambar tali + biji bernomor, label di kanan -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wadahStepperTasbih"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingBottom="24dp"
            app:layout_constraintWidth_max="440dp"
            app:layout_constraintTop_toBottomOf="@id/pembatasSektor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0">

            <com.fk.arsip.TasbihConnectorView
                android:id="@+id/connectorTasbih"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/wadahDaftarFase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="42dp"
                android:paddingStart="84dp"
                android:paddingEnd="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <include layout="@layout/item_stepper" android:id="@+id/fase1" />
                <include layout="@layout/item_stepper" android:id="@+id/fase2" />
                <include layout="@layout/item_stepper" android:id="@+id/fase3" />
                <include layout="@layout/item_stepper" android:id="@+id/fase4" />
                <include layout="@layout/item_stepper" android:id="@+id/fase5" />
                <include layout="@layout/item_stepper" android:id="@+id/fase6" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
