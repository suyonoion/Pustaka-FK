<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelStepperUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004D40"
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelInisialisasiUtama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- JUDUL -->
        <TextView
            android:id="@+id/teksJudulAplikasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PUSTAKA FK"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- INDIKATOR GAMBAR ANIMASI -->
        <ImageView
            android:id="@+id/indikatorVisualMesin"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/img_1"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/teksJudulAplikasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PROGRESS BAR -->
       <ProgressBar
    android:id="@+id/progressBarInisialisasi"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="0dp"
    android:layout_height="8dp"
    android:layout_marginHorizontal="24dp"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/progress_bar_toska"
    app:layout_constraintTop_toBottomOf="@id/indikatorVisualMesin"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TEKS % DI ATAS BAR -->
       <TextView
    android:id="@+id/teksDetailProgress"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="0%"
    android:textSize="18sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    app:layout_constraintBottom_toBottomOf="@id/progressBarInisialisasi"  
    app:layout_constraintTop_toTopOf="@id/progressBarInisialisasi"        
    app:layout_constraintEnd_toEndOf="@id/progressBarInisialisasi"        
    android:layout_marginEnd="10dp"/>

        <!-- TEKS STATUS -->
        <TextView
            android:id="@+id/teksStatusInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Menghubungkan ke Server Data"
            android:textSize="14sp"
            android:textColor="#B2DFDB"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/progressBarInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TEKS NASEHAT -->
        <TextView
            android:id="@+id/teksNasehatInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mohon tidak menutup aplikasi saat penyusunan database berlangsung..."
            android:textSize="12sp"
            android:textColor="#80CBC4"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/teksStatusInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- GARIS PEMBATAS -->
        <View
            android:id="@+id/pembatasSektor"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#00695C"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/teksNasehatInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- STEPPER FASE 1 -->
<!-- STEPPER FASE 1 -->
<include layout="@layout/item_stepper" android:id="@+id/fase1"
    app:layout_constraintTop_toBottomOf="@id/pembatasSektor" android:layout_marginTop="24dp"/>
<!-- STEPPER FASE 2 -->
<include layout="@layout/item_stepper" android:id="@+id/fase2"
    app:layout_constraintTop_toBottomOf="@id/fase1"/>
    <include layout="@layout/item_stepper" android:id="@+id/fase3"
    app:layout_constraintTop_toBottomOf="@id/fase2"/>
    <include layout="@layout/item_stepper" android:id="@+id/fase4"
    app:layout_constraintTop_toBottomOf="@id/fase3"/>
<include layout="@layout/item_stepper" android:id="@+id/fase5"
    app:layout_constraintTop_toBottomOf="@id/fase4"/>
    <include layout="@layout/item_stepper" android:id="@+id/fase6"
    app:layout_constraintTop_toBottomOf="@id/fase5"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>