<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelStepperUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kayu_mandala" 
    android:padding="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelInisialisasiUtama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- JUDUL: Menggunakan font dekoratif dan warna emas -->
        <TextView
            android:id="@+id/teksJudulAplikasi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PUSTAKA FK"
            android:textSize="32sp"
            android:fontFamily="serif" 
            android:textStyle="bold"
            android:textColor="@color/tasbih_emas_teks"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- INDIKATOR VISUAL: Diganti menjadi ikon Al-Quran bercahaya -->
        <ImageView
            android:id="@+id/indikatorVisualMesin"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/img_quran_glow" 
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/teksJudulAplikasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- PROGRESS BAR: Diselaraskan dengan tema warna kayu/emas -->
        <ProgressBar
            android:id="@+id/progressBarInisialisasi"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="24dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_tasbih" 
            app:layout_constraintTop_toBottomOf="@id/indikatorVisualMesin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <!-- TEKS %: Diubah ke warna emas dengan background kapsul (opsional) -->
        <TextView
            android:id="@+id/teksDetailProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/tasbih_emas_teks"
            android:background="@drawable/bg_persentase_outline"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            app:layout_constraintBottom_toBottomOf="@id/progressBarInisialisasi"  
            app:layout_constraintTop_toTopOf="@id/progressBarInisialisasi"        
            app:layout_constraintEnd_toEndOf="@id/progressBarInisialisasi"        
            android:layout_marginEnd="0dp"/>

        <!-- TEKS STATUS: Warna disesuaikan -->
        <TextView
            android:id="@+id/teksStatusInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2m 5d tersisa • 527 Kbps | 51,1 MB / 115,5 MB"
            android:textSize="12sp"
            android:textColor="@color/tasbih_emas_teks"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/progressBarInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TEKS NASEHAT: Warna disesuaikan -->
        <TextView
            android:id="@+id/teksNasehatInisialisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kesabaran dalam menunggu adalah bagian dari adab menuntut ilmu."
            android:textSize="13sp"
            android:textColor="@color/tasbih_pudar_teks"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/teksStatusInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- GARIS PEMBATAS: Diubah menjadi ornamen pemisah klasik -->
        <ImageView
            android:id="@+id/pembatasSektor"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ornamen_garis" 
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/teksNasehatInisialisasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <FrameLayout
    android:id="@+id/wadahStepperTasbih"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:paddingHorizontal="16dp"
    app:layout_constraintTop_toBottomOf="@id/pembatasSektor"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <com.fk.arsip.TasbihConnectorView
        android:id="@+id/connectorTasbih"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"/>

    <LinearLayout
        android:id="@+id/wadahDaftarFase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/item_stepper" android:id="@+id/fase1"/>
        <include layout="@layout/item_stepper" android:id="@+id/fase2"/>
        <include layout="@layout/item_stepper" android:id="@+id/fase3"/>
        <include layout="@layout/item_stepper" android:id="@+id/fase4"/>
        <include layout="@layout/item_stepper" android:id="@+id/fase5"/>
        <include layout="@layout/item_stepper" android:id="@+id/fase6"/>

    </LinearLayout>
</FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
