<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- PIPA VERTIKAL ATAS -->
    <View
        android:id="@+id/lineTop"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#006D5B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/timelineBranchTop"
        android:layout_marginStart="16dp"/>

    <!-- PIPA VERTIKAL TENGAH -->
    <View
        android:id="@+id/lineMiddle"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#006D5B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineBranchTop"
        app:layout_constraintBottom_toTopOf="@id/timelineBranchBottom"
        android:layout_marginStart="16dp"/>

    <!-- PIPA VERTIKAL BAWAH -->
    <View
        android:id="@+id/lineBottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#006D5B"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timelineBranchBottom"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="16dp"/>

    <!-- CABANG ATAS -->
    <View
        android:id="@+id/timelineBranchTop"
        android:layout_width="16dp"
        android:layout_height="2dp"
        android:background="#006D5B"
        app:layout_constraintStart_toStartOf="@id/lineTop"
        app:layout_constraintTop_toTopOf="@id/cardBiografi"
        android:layout_marginTop="24dp"/>

    <!-- TITIK ATAS (Nempel tepat di dinding kiri kartu) -->
    <View
        android:id="@+id/dotTop"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_dot_green"
        app:layout_constraintStart_toEndOf="@id/timelineBranchTop"
        app:layout_constraintTop_toTopOf="@id/timelineBranchTop"
        app:layout_constraintBottom_toBottomOf="@id/timelineBranchTop"/>

    <!-- CABANG BAWAH -->
    <View
        android:id="@+id/timelineBranchBottom"
        android:layout_width="16dp"
        android:layout_height="2dp"
        android:background="#006D5B"
        app:layout_constraintStart_toStartOf="@id/lineBottom"
        app:layout_constraintBottom_toBottomOf="@id/cardBiografi"
        android:layout_marginBottom="24dp"/>

    <!-- TITIK BAWAH (Nempel tepat di dinding kiri kartu) -->
    <View
        android:id="@+id/dotBottom"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_dot_green"
        app:layout_constraintStart_toEndOf="@id/timelineBranchBottom"
        app:layout_constraintTop_toTopOf="@id/timelineBranchBottom"
        app:layout_constraintBottom_toBottomOf="@id/timelineBranchBottom"/>

    <!-- MODUL KARTU -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBiografi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="15dp" 
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/dotTop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        android:background="@android:color/transparent"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
