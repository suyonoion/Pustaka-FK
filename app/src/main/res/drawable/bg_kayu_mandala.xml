<?xml version="1.0" encoding="utf-8"?>
<!-- Latar kayu bertekstur serat (ubin 512px, diulang) + vinyet gelap di sudut. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:src="@drawable/tekstur_kayu" android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="75%p"
                android:centerX="0.5" android:centerY="0.4"
                android:startColor="#00000000" android:centerColor="#22000000" android:endColor="#99000000" />
        </shape>
    </item>
</layer-list>
