<?xml version="1.0" encoding="utf-8"?>
<!-- Kapsul persentase berbingkai emas ganda (Gambar B). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#80180D07" />
            <stroke android:width="1.5dp" android:color="#D9A94E" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <stroke android:width="0.7dp" android:color="#99D9A94E" />
        </shape>
    </item>
</layer-list>
